# Set this to the final HTTPS subdomain before deployment.
NEXT_PUBLIC_SITE_URL=https://gematria-lab.saulspodship.com

# Optional persistent SQLite path. For a single-host deployment, mount durable storage here.
# GEMATRIA_DB_PATH=/var/lib/gematria-lab/research-lab.sqlite

# Optional server-only Anthropic proxy. Leave unset to use curated retrieval-only briefs.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=<currently-supported-model-id>
